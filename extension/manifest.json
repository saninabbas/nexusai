{
  "manifest_version": 3,
  "name": "Nexus AI — Binance Futures AutoBot",
  "version": "1.0.0",
  "description": "Autonomous Binance Futures trading bot powered by AI.",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://fapi.binance.com/*",
    "https://testnet.binancefuture.com/*",
    "https://*.workers.dev/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Nexus AI Bot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}