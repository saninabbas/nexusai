{
  "manifest_version": 3,
  "name": "Nexus Trader – Futures Control",
  "version": "3.1.0",
  "description": "Paper and Binance Futures Testnet strategy controls with device-bound Nexus licensing.",
  "homepage_url": "https://nexus-ai-trading-bot.local-sass.workers.dev",
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "https://fapi.binance.com/*",
    "https://demo-fapi.binance.com/*",
    "https://nexus-ai-trading-bot.local-sass.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Nexus Trader",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html"
}
